# ═══════════════════════════════════════════════════════════════
# تنظیمات محیط توسعه — این فایل توسط Vite فقط در حالت `npm run dev` خوانده می‌شود
#
# ⚠️ اگر این مقادیر خالی بمانند، اپ به دیتابیس اصلی (پروداکشن) وصل می‌شود
# و هر تغییری که در توسعه بدهید روی داده‌های واقعی ذخیره خواهد شد!
#
# برای توسعهٔ امن: یک پروژهٔ رایگان در https://supabase.com بسازید،
# جدول‌های موردنیاز را از پوشهٔ supabase/ بسازید و مقادیر را اینجا وارد کنید.
# ═══════════════════════════════════════════════════════════════

# آدرس پروژهٔ سوپابیس توسعه (مثال: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# کلید عمومی (anon) پروژهٔ سوپابیس توسعه
VITE_SUPABASE_ANON_KEY=
